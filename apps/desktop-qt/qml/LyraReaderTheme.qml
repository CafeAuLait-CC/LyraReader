    readonly property color pressedBg: dark ? "#4B3C27" : "#E1D7C7"
    readonly property color selectedBg: dark ? "#514022" : "#F5DEB3"
    readonly property color selectedFg: dark ? "#F5DEB3" : "#5B4319"
    readonly property color inactiveSelectionBg: dark ? "#38342D" : "#E9E2D8"
    readonly property color inactiveSelectionFg: dark ? "#C0B5A4" : "#665C50"
    readonly property color focusRing: dark ? "#E7C07B" : "#9A6A19"
    readonly property color menuSelectedBg: dark ? "#514022" : "#F5DEB3"
    readonly property color menuSelectedFg: dark ? "#F5DEB3" : "#4C391C"
    readonly property color textSelectionBg: dark ? "#5B4828" : "#E8D9AF"
    readonly property color textSelectionFg: dark ? "#FFF4DE" : "#302B25"
    readonly property color searchMatchBg: dark ? "#4C4025" : "#F7E8A4"
