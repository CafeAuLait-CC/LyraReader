import QtQuick

// Lyra palette 1.0 (sRGB), matching LyraReaderTheme on macOS.
// PDF pixels retain the source document colors; these tokens style the application.
QtObject {
    property bool dark: false
    readonly property color windowBg: dark ? "#201F1D" : "#FAFAFA"
    readonly property color titlebarBg: dark ? "#24221F" : "#F4F1EC"
    readonly property color toolbarBg: dark ? "#28251F" : "#F7F4EF"
    readonly property color tabbarBg: dark ? "#211F1C" : "#F0EBE3"
    readonly property color sidebarBg: dark ? "#24221E" : "#F3EFE8"
    readonly property color panelBg: dark ? "#2B2823" : "#F8F6F2"
    readonly property color raisedBg: dark ? "#343029" : "#FFFDFA"
    readonly property color menuBg: dark ? "#343029" : "#FFFDFA"
    readonly property color fieldBg: dark ? "#1F1D1A" : "#FFFDFA"
    readonly property color canvasBg: dark ? "#171716" : "#E7E2D9"
    readonly property color emptyBg: dark ? "#1B1A18" : "#EEEAE3"
    readonly property color statusbarBg: dark ? "#24221F" : "#F4F1EC"
    readonly property color documentInk: "#302B25"
    // Transparent artwork is previewed on original paper, independently of the UI theme.
    readonly property color documentPaper: "#FFFFFF"
    readonly property color textPrimary: dark ? "#F1ECE3" : "#302B25"
    readonly property color textSecondary: dark ? "#C8BFAF" : "#655C50"
    readonly property color textTertiary: dark ? "#B4A995" : "#675C50"
    readonly property color textPlaceholder: dark ? "#B0A38F" : "#786E62"
    readonly property color textDisabled: dark ? "#736D62" : "#A79E90"
    readonly property color iconPrimary: dark ? "#D4C9B7" : "#5F564B"
    readonly property color iconSecondary: dark ? "#ADA18C" : "#7B7062"
    readonly property color border: dark ? "#494237" : "#DDD6CA"
    readonly property color separator: dark ? "#3C362E" : "#E5DFD5"
    readonly property color controlBorder: dark ? "#9A8B73" : "#8C8173"
    readonly property color pageEdge: dark ? "#5C5345" : "#C7BFAF"
    readonly property color scrollThumb: dark ? "#8D806D" : "#837968"
    readonly property color scrollThumbHover: dark ? "#AD9A7A" : "#746653"
    readonly property color accent: dark ? "#E7C07B" : "#88611B"
    readonly property color accentHover: dark ? "#F2D49F" : "#6E4C10"
    readonly property color accentPressed: dark ? "#D6A654" : "#573B09"
    readonly property color onAccent: dark ? "#2D2417" : "#FFFFFF"
